; RUN: opt -S -passes='sroa<modify-cfg>' < %s | FileCheck %s

; The motivating case: two-slot alloca is accessed with indices 0 or 1, and
; also with direct loads and stores to the whole alloca.
define void @two_slot_goal(i64 %idx) {
; CHECK-LABEL: define void @two_slot_goal(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [2 x i32], align 4
; CHECK-NEXT:    store i64 0, ptr [[ALLOCA]], align 4
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, %[[ENTRY]] ], [ [[I_NEXT:%.*]], %[[LOOP]] ]
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [2 x i32], ptr [[ALLOCA]], i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[C:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    [[INC:%.*]] = add i32 [[C]], 1
; CHECK-NEXT:    store i32 [[INC]], ptr [[GEP]], align 4
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], 4
; CHECK-NEXT:    br i1 [[DONE]], label %[[EXIT:.*]], label %[[LOOP]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    [[C0:%.*]] = load i64, ptr [[ALLOCA]], align 4
; CHECK-NEXT:    [[C1:%.*]] = load i32, ptr [[ALLOCA]], align 4
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 4
; CHECK-NEXT:    [[C2:%.*]] = load i32, ptr [[GEP1]], align 4
; CHECK-NEXT:    call void @use_i64(i64 [[C0]])
; CHECK-NEXT:    call void @use_i32(i32 [[C1]])
; CHECK-NEXT:    call void @use_i32(i32 [[C2]])
; CHECK-NEXT:    ret void
;
entry:
  %alloca = alloca [2 x i32], align 4
  store i64 0, ptr %alloca, align 4
  br label %loop

loop:
  %i = phi i64 [ 0, %entry ], [ %i.next, %loop ]
  %gep = getelementptr inbounds nuw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %c = load i32, ptr %gep, align 4
  %inc = add i32 %c, 1
  store i32 %inc, ptr %gep, align 4
  %i.next = add nuw nsw i64 %i, 1
  %done = icmp eq i64 %i.next, 4
  br i1 %done, label %exit, label %loop

exit:
  %c0 = load i64, ptr %alloca, align 4
  %c1 = load i32, ptr %alloca, align 4
  %gep1 = getelementptr inbounds nuw i8, ptr %alloca, i64 4
  %c2 = load i32, ptr %gep1, align 4
  call void @use_i64(i64 %c0)
  call void @use_i32(i32 %c1)
  call void @use_i32(i32 %c2)
  ret void
}

; The minimal case that we can transform. The alloca is uninitialized, so it
; loads as `undef`.
define i32 @two_slot_minimal(i64 %idx) {
; CHECK-LABEL: define i32 @two_slot_minimal(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [2 x i32], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [2 x i32], ptr [[ALLOCA]], i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %alloca = alloca [2 x i32], align 4
  %gep = getelementptr inbounds nuw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %v = load i32, ptr %gep, align 4
  ret i32 %v
}

; The minimal case, but the alloca is initialized.
define i32 @two_slot_minimal_no_undef(i64 %idx, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @two_slot_minimal_no_undef(
; CHECK-SAME: i64 [[IDX:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [2 x i32], align 4
; CHECK-NEXT:    store i32 [[A]], ptr [[ALLOCA]], align 4
; CHECK-NEXT:    [[ALLOCA_1:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 4
; CHECK-NEXT:    store i32 [[B]], ptr [[ALLOCA_1]], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [2 x i32], ptr [[ALLOCA]], i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %alloca = alloca [2 x i32], align 4
  store i32 %a, ptr %alloca, align 4
  %alloca.1 = getelementptr inbounds nuw i8, ptr %alloca, i64 4
  store i32 %b, ptr %alloca.1, align 4
  %gep = getelementptr inbounds nuw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %v = load i32, ptr %gep, align 4
  ret i32 %v
}

; It's possible to index the alloca in more than two ways: can't split.
define i32 @three_slot(i64 %idx) {
; CHECK-LABEL: define i32 @three_slot(
; CHECK-SAME: i64 [[IDX:%.*]]) {
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [3 x i32], align 4
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [2 x i32], ptr [[ALLOCA]], i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %alloca = alloca [3 x i32], align 4
  %gep = getelementptr inbounds nuw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %v = load i32, ptr %gep, align 4
  ret i32 %v
}

; We could choose to split here or not. Currently the two-slot GEP splitting
; and the rest of the SROA are out of sync: we convert the GEP and the alloca
; isn't split. FIXME
define i32 @overlapping_access_partial_1(i64 %idx, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @overlapping_access_partial_1(
; CHECK-SAME: i64 [[IDX:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [2 x i32], align 4
; CHECK-NEXT:    store i32 [[A]], ptr [[ALLOCA]], align 4
; CHECK-NEXT:    [[ALLOCA_1:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 4
; CHECK-NEXT:    store i32 [[B]], ptr [[ALLOCA_1]], align 4
; CHECK-NEXT:    [[GEP0:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 1
; CHECK-NEXT:    [[V0:%.*]] = load i32, ptr [[GEP0]], align 1
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr inbounds nuw i32, ptr [[ALLOCA]], i64 [[IDX]]
; CHECK-NEXT:    [[V1:%.*]] = load i32, ptr [[GEP1]], align 4
; CHECK-NEXT:    [[RET:%.*]] = add i32 [[V0]], [[V1]]
; CHECK-NEXT:    ret i32 [[RET]]
;
  %alloca = alloca [2 x i32], align 4

  ; Set the first slot.
  store i32 %a, ptr %alloca, align 4

  ; Set the second slot.
  %alloca.1 = getelementptr inbounds nuw i8, ptr %alloca, i64 4
  store i32 %b, ptr %alloca.1, align 4

  ; Accesses [alloca + 1, alloca + 5)
  %gep0 = getelementptr inbounds nuw i8, ptr %alloca, i64 1
  %v0 = load i32, ptr %gep0, align 1

  ; Accesses [alloca, alloca + 4) or [alloca + 4, alloca + 8)
  %gep1 = getelementptr inbounds nuw i32, ptr %alloca, i64 %idx
  %v1 = load i32, ptr %gep1, align 4

  %ret = add i32 %v0, %v1
  ret i32 %ret
}

; Same as above, but the overlapping access is done via memmove. FIXME
define i32 @overlapping_access_partial_2(i64 %idx, i32 %a, i32 %b) {
; CHECK-LABEL: define i32 @overlapping_access_partial_2(
; CHECK-SAME: i64 [[IDX:%.*]], i32 [[A:%.*]], i32 [[B:%.*]]) {
; CHECK-NEXT:    [[ALLOCA:%.*]] = alloca [2 x i32], align 4
; CHECK-NEXT:    store i32 [[A]], ptr [[ALLOCA]], align 4
; CHECK-NEXT:    [[ALLOCA_1:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 4
; CHECK-NEXT:    store i32 [[B]], ptr [[ALLOCA_1]], align 4
; CHECK-NEXT:    [[DST:%.*]] = getelementptr inbounds nuw i8, ptr [[ALLOCA]], i64 1
; CHECK-NEXT:    call void @llvm.memmove.p0.p0.i64(ptr [[DST]], ptr [[ALLOCA]], i64 2, i1 false)
; CHECK-NEXT:    [[GEP:%.*]] = getelementptr inbounds nuw [2 x i32], ptr [[ALLOCA]], i64 0, i64 [[IDX]]
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[GEP]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %alloca = alloca [2 x i32], align 4
  store i32 %a, ptr %alloca, align 4
  %alloca.1 = getelementptr inbounds nuw i8, ptr %alloca, i64 4
  store i32 %b, ptr %alloca.1, align 4

  ; Accesses [alloca + 1, alloca + 5)
  %dst = getelementptr inbounds nuw i8, ptr %alloca, i64 1
  call void @llvm.memmove.p0.p0.i64(ptr %dst, ptr %alloca, i64 2, i1 false)

  ; Accesses [alloca, alloca + 4) or [alloca + 4, alloca + 8)
  %gep = getelementptr inbounds nuw [2 x i32], ptr %alloca, i64 0, i64 %idx
  %v = load i32, ptr %gep, align 4
  ret i32 %v
}

