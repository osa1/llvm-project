; RUN: opt -passes='default<O3>' -S < %s | FileCheck %s

; n = x & 3 and the switch says n != 0 and n != 1, so the loop below runs at
; most twice. SimplifyCFG removes the unreachable case early in the pipeline;
; make sure the fact that n != 0 survives so that the loop is fully unrolled.
;
; void f(unsigned long *r, unsigned x) {
;   unsigned long n = x & 3;
;   switch (n) {
;   case 0:
;     __builtin_unreachable();
;   case 1:
;     return;
;   }
;   for (unsigned long i = 0; i < n - 1; ++i)
;     r[i] += 1;
; }

define void @f(ptr noundef %r, i32 noundef %x) {
; CHECK-LABEL: define void @f(
; CHECK-SAME: ptr nofree noundef captures(none) [[R:%.*]], i32 noundef [[X:%.*]]) local_unnamed_addr #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[AND:%.*]] = and i32 [[X]], 3
; CHECK-NEXT:    [[TMP0:%.*]] = icmp ne i32 [[AND]], 0
; CHECK-NEXT:    tail call void @llvm.assume(i1 [[TMP0]])
; CHECK-NEXT:    [[COND:%.*]] = icmp eq i32 [[AND]], 1
; CHECK-NEXT:    br i1 [[COND]], label %[[EXIT:.*]], label %[[LOOP_BODY_PEEL:.*]]
; CHECK:       [[LOOP_BODY_PEEL]]:
; CHECK-NEXT:    [[V_PEEL:%.*]] = load i64, ptr [[R]], align 8
; CHECK-NEXT:    [[ADD_PEEL:%.*]] = add i64 [[V_PEEL]], 1
; CHECK-NEXT:    store i64 [[ADD_PEEL]], ptr [[R]], align 8
; CHECK-NEXT:    [[CMP_PEEL:%.*]] = icmp eq i32 [[AND]], 3
; CHECK-NEXT:    br i1 [[CMP_PEEL]], label %[[LOOP_BODY_PREHEADER_PEEL_NEWPH:.*]], label %[[EXIT]]
; CHECK:       [[LOOP_BODY_PREHEADER_PEEL_NEWPH]]:
; CHECK-NEXT:    [[ARRAYIDX:%.*]] = getelementptr inbounds nuw i8, ptr [[R]], i64 8
; CHECK-NEXT:    [[ARRAYIDX_PROMOTED:%.*]] = load i64, ptr [[ARRAYIDX]], align 8
; CHECK-NEXT:    [[ADD:%.*]] = add i64 [[ARRAYIDX_PROMOTED]], 1
; CHECK-NEXT:    store i64 [[ADD]], ptr [[ARRAYIDX]], align 8
; CHECK-NEXT:    br label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  %and = and i32 %x, 3
  %n = zext i32 %and to i64
  switch i64 %n, label %loop.ph [
  i64 0, label %unreach
  i64 1, label %exit
  ]

unreach:
  unreachable

loop.ph:
  br label %loop.cond

loop.cond:
  %i = phi i64 [ 0, %loop.ph ], [ %inc, %loop.body ]
  %sub = sub i64 %n, 1
  %cmp = icmp ult i64 %i, %sub
  br i1 %cmp, label %loop.body, label %exit

loop.body:
  %arrayidx = getelementptr inbounds nuw i64, ptr %r, i64 %i
  %v = load i64, ptr %arrayidx, align 8
  %add = add i64 %v, 1
  store i64 %add, ptr %arrayidx, align 8
  %inc = add i64 %i, 1
  br label %loop.cond

exit:
  ret void
}
